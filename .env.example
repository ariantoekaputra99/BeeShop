# ---- Database ----
POSTGRES_PASSWORD=bee123

# ---- Admin ----
# Dipakai SEKALI untuk membuat akun OWNER pertama saat tabel admin masih kosong.
# Setelah login pertama: ganti password dari menu Profil, lalu kosongkan dua baris ini.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_HOURS=12
# Set "framework" bila backend di belakang reverse proxy (agar IP login tercatat benar)
FORWARD_HEADERS_STRATEGY=none

# ---- Integrasi BeePos-App (WAJIB diisi, string acak panjang: openssl rand -hex 32) ----
BEEPOS_INTEGRATION_KEY=

# ---- Storefront ----
CORS_ORIGINS=http://localhost:5173
STOREFRONT_URL=http://localhost:5173
VITE_API_URL=http://localhost:8081/api
SEED_DEMO_DATA=true

# ---- Order ----
PAYMENT_TIMEOUT_MINUTES=60

# ---- Payment (Midtrans Snap) ----
# Kosongkan server key untuk mode mock (simulasi). Isi untuk memakai Midtrans.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SANDBOX=true

# ---- Shipping ----
# mock | rajaongkir | biteship
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=
SHIPPING_COURIERS=jne,sicepat,jnt,anteraja
SHIPPING_CACHE_TTL_MINUTES=10
# mock: kota asal
SHIPPING_ORIGIN_CITY=Jakarta
# rajaongkir: ID destinasi asal toko (lihat README)
SHIPPING_ORIGIN_ID=
# biteship: kode pos asal toko
SHIPPING_ORIGIN_POSTAL_CODE=
