# =====================================================================
# BeeShop - PROD
# Simpan nilai asli di secret manager (GitHub Environments, Vault, AWS/GCP Secret Manager),
# BUKAN di file yang di-commit.
# Aplikasi MENOLAK START bila: payment mock, key Midtrans sandbox (SB-...),
# ongkir mock, CORS/storefront bukan https, password DB lemah, integration key < 32 karakter,
# atau data demo aktif.
# =====================================================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://<host-db-prod>:5432/beeshop
SPRING_DATASOURCE_USERNAME=beeshop_app
SPRING_DATASOURCE_PASSWORD=<isi, min 12 karakter>
DB_POOL_SIZE=20

CORS_ORIGINS=https://<domain-anda>,https://www.<domain-anda>
STOREFRONT_URL=https://<domain-anda>

ADMIN_BOOTSTRAP_USERNAME=<username owner>
# Min 16 karakter. WAJIB dihapus setelah login pertama & ganti password
ADMIN_BOOTSTRAP_PASSWORD=<isi>
ADMIN_SESSION_HOURS=8

# openssl rand -hex 32  (unik, beda dengan SIT/UAT)
BEEPOS_INTEGRATION_KEY=<isi>

# Midtrans PRODUCTION (key TANPA awalan SB-)
MIDTRANS_SERVER_KEY=Mid-server-<isi>
MIDTRANS_CLIENT_KEY=Mid-client-<isi>
PAYMENT_TIMEOUT_MINUTES=60

# biteship (biteship_live...) atau rajaongkir
SHIPPING_PROVIDER=biteship
SHIPPING_API_KEY=<isi>
SHIPPING_ORIGIN_POSTAL_CODE=<kode pos gudang>
SHIPPING_ORIGIN_ID=
SHIPPING_COURIERS=jne,sicepat,jnt,anteraja
