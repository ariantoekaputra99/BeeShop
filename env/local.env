# =====================================================================
# BeeShop - LOCAL (laptop developer). Siap pakai, aman di-commit:
# semua nilai di sini HANYA untuk lokal, jangan dipakai di server mana pun.
#
# Dibaca otomatis oleh backend (profile "local") dan docker-compose.
# Mau pakai Midtrans sandbox / API ongkir sungguhan di lokal? Jangan edit file ini;
# salin baris yang perlu ke env/local.override.env (di-ignore git).
# =====================================================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081

# ---- Database (docker compose up -d postgres -> port 5433) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/beeshop
SPRING_DATASOURCE_USERNAME=beeuser
SPRING_DATASOURCE_PASSWORD=bee123

# ---- URL ----
CORS_ORIGINS=http://localhost:5173
STOREFRONT_URL=http://localhost:5173

# ---- Admin (OWNER pertama dibuat saat tabel admin kosong) ----
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin-lokal-123
ADMIN_SESSION_HOURS=12

# ---- Integrasi BeePos-App ----
BEEPOS_INTEGRATION_KEY=local-beepos-key-jangan-dipakai-di-server

# ---- Payment: mock = halaman bayar simulasi ----
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
PAYMENT_TIMEOUT_MINUTES=60

# ---- Ongkir: mock = tarif simulasi ----
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=
SHIPPING_ORIGIN_CITY=Jakarta
SHIPPING_ORIGIN_POSTAL_CODE=10110
SHIPPING_ORIGIN_ID=
SHIPPING_COURIERS=jne,sicepat,jnt,anteraja
