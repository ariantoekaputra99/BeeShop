# Salin menjadi env/local.override.env (di-ignore git) untuk override pribadi di lokal.
# Nilai di sini menimpa env/local.env.

# Contoh: coba Midtrans sandbox dari lokal
# PAYMENT_PROVIDER=midtrans
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx

# Contoh: coba Biteship test key dari lokal
# SHIPPING_PROVIDER=biteship
# SHIPPING_API_KEY=biteship_test.xxxxxxxx
# SHIPPING_ORIGIN_POSTAL_CODE=12440
