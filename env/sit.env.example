# =====================================================================
# BeeShop - SIT (System Integration Test, server QA/dev)
# Salin ke secret manager / env server SIT. JANGAN commit file berisi nilai asli.
# Profile sit: data demo ON, log DEBUG, Midtrans selalu sandbox.
# =====================================================================
SPRING_PROFILES_ACTIVE=sit
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://<host-db-sit>:5432/beeshop_sit
SPRING_DATASOURCE_USERNAME=beeshop_sit
SPRING_DATASOURCE_PASSWORD=<isi>

CORS_ORIGINS=https://sit.<domain-anda>
STOREFRONT_URL=https://sit.<domain-anda>

ADMIN_BOOTSTRAP_USERNAME=admin
# Hapus setelah login pertama & ganti password
ADMIN_BOOTSTRAP_PASSWORD=<isi>

# openssl rand -hex 32
BEEPOS_INTEGRATION_KEY=<isi>

# mock atau midtrans (sandbox). Tim QA biasanya cukup mock.
PAYMENT_PROVIDER=mock
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# mock, atau biteship/rajaongkir dengan test key
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=
SHIPPING_ORIGIN_POSTAL_CODE=
SHIPPING_ORIGIN_ID=
SHIPPING_COURIERS=jne,sicepat,jnt,anteraja

SEED_DEMO_DATA=true
