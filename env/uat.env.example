# =====================================================================
# BeeShop - UAT (User Acceptance Test, semirip mungkin dengan PROD)
# Salin ke secret manager / env server UAT. JANGAN commit file berisi nilai asli.
# Aplikasi MENOLAK START bila: payment mock, key Midtrans bukan sandbox (SB-...),
# ongkir mock, CORS/storefront bukan https, password DB lemah, integration key < 32 karakter.
# =====================================================================
SPRING_PROFILES_ACTIVE=uat
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://<host-db-uat>:5432/beeshop_uat
SPRING_DATASOURCE_USERNAME=beeshop_uat
SPRING_DATASOURCE_PASSWORD=<isi, min 12 karakter>
DB_POOL_SIZE=10

CORS_ORIGINS=https://uat.<domain-anda>
STOREFRONT_URL=https://uat.<domain-anda>

ADMIN_BOOTSTRAP_USERNAME=admin
# Min 16 karakter. Hapus setelah login pertama & ganti password
ADMIN_BOOTSTRAP_PASSWORD=<isi>

# openssl rand -hex 32  (beda dengan SIT dan PROD)
BEEPOS_INTEGRATION_KEY=<isi>

# Midtrans SANDBOX (key diawali SB-)
MIDTRANS_SERVER_KEY=SB-Mid-server-<isi>
MIDTRANS_CLIENT_KEY=SB-Mid-client-<isi>
PAYMENT_TIMEOUT_MINUTES=60

# biteship (biteship_test...) atau rajaongkir
SHIPPING_PROVIDER=biteship
SHIPPING_API_KEY=<isi>
SHIPPING_ORIGIN_POSTAL_CODE=<kode pos gudang>
SHIPPING_ORIGIN_ID=
SHIPPING_COURIERS=jne,sicepat,jnt,anteraja

# ---- Gambar produk ----
# Harus volume persisten (bukan filesystem container), dan dibackup bersama database
IMAGE_DIR=/app/data/images
